# {{ ansible_managed }}
[Unit]
Description=Pasadizo ({{ pasadizo_service_name }})
Documentation=https://github.com/pasadizo-net/pasadizo
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
Type=simple
User={{ pasadizo_user }}
Group={{ pasadizo_group }}
StateDirectory={{ pasadizo_service_name }}
LogsDirectory={{ pasadizo_service_name }}
ExecStart={{ pasadizo_binary }} -D /var/lib/{{ pasadizo_service_name }} -c {{ pasadizo_config_file }} run
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE={{ pasadizo_limit_nofile }}
{% if pasadizo_capabilities | length > 0 %}
AmbientCapabilities={{ pasadizo_capabilities | join(' ') }}
CapabilityBoundingSet={{ pasadizo_capabilities | join(' ') }}
{% else %}
CapabilityBoundingSet=
NoNewPrivileges=true
{% endif %}
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
{% if pasadizo_service_extra %}
{{ pasadizo_service_extra }}
{% endif %}

[Install]
WantedBy=multi-user.target
