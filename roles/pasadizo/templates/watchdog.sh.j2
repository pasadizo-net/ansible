#!/bin/bash
# {{ ansible_managed }}
# End-to-end health check for {{ pasadizo_service_name }}: fetch a URL through
# each proxy and restart the service when a proxy cannot carry traffic. A TCP
# connect is not enough: a proxy can accept connections while every tunnel
# behind it is dead. Retries before restarting, and does not restart again
# within the cooldown, so a dead exit does not become a restart loop.
set -u

SERVICE={{ pasadizo_service_name | quote }}
PROXIES=({% for proxy in pasadizo_watchdog_proxies %}{{ proxy | quote }} {% endfor %})
URLS=({% for url in pasadizo_watchdog_urls %}{{ url | quote }} {% endfor %})
RETRIES={{ pasadizo_watchdog_retries | int }}
RETRY_INTERVAL={{ pasadizo_watchdog_retry_interval | int }}
TIMEOUT={{ pasadizo_watchdog_timeout | int }}
COOLDOWN={{ pasadizo_watchdog_cooldown | int }}

# Succeeds when any URL answers 2xx or 3xx through the proxy.
probe() {
  local proxy=$1 url code
  for url in "${URLS[@]}"; do
    code=$(curl -s -o /dev/null -w '%{http_code}' -m "$TIMEOUT" -x "$proxy" "$url")
    case "$code" in 2??|3??) return 0 ;; esac
  done
  return 1
}

for attempt in $(seq 1 "$RETRIES"); do
  FAILED=()
  NFAILED=0
  for proxy in "${PROXIES[@]}"; do
    probe "$proxy" || { FAILED+=("$proxy"); NFAILED=$((NFAILED + 1)); }
  done

  if [ "$NFAILED" -eq 0 ]; then
    exit 0
  fi

  echo "Attempt $attempt/$RETRIES: ${FAILED[*]} cannot reach ${URLS[*]}"

  if [ "$attempt" -lt "$RETRIES" ]; then
    sleep "$RETRY_INTERVAL"
  fi
done

STARTED=$(systemctl show -p ActiveEnterTimestampMonotonic --value "$SERVICE")
NOW=$(awk '{printf "%d", $1 * 1000000}' /proc/uptime)
if [ $(( (NOW - STARTED) / 1000000 )) -lt "$COOLDOWN" ]; then
  echo "All $RETRIES attempts failed, but $SERVICE started less than ${COOLDOWN}s ago; not restarting"
  exit 1
fi

echo "All $RETRIES attempts failed, restarting $SERVICE"
systemctl restart "$SERVICE"
